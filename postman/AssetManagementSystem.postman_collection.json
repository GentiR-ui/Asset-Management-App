{
  "info": {
    "name": "Asset Management System — Auth & Users",
    "description": "Të gjitha endpoint-et e Fazës 1.\n\nRENDI I TESTIMIT:\n1. Auth → Register\n2. Merr token-in e konfirmimit nga KONSOLA e serverit → vendose te variabla `confirmToken`\n3. Auth → Confirm Email\n4. Auth → Login (token-i ruhet automatikisht)\n5. Pjesa tjetër\n\nVariablat ruhen vetë ku është e mundur.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5062" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "confirmToken", "value": "" },
    { "key": "resetToken", "value": "" },
    { "key": "testEmail", "value": "postman@ks-aps.com" },
    { "key": "testPassword", "value": "Test@1234" },
    { "key": "adminEmail", "value": "admin@system.com" },
    { "key": "adminPassword", "value": "Admin123!" }
  ],
  "item": [
    {
      "name": "01 · Auth",
      "item": [
        {
          "name": "Register — valid (200)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Tester\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"confirmPassword\": \"{{testPassword}}\"\n}"
            },
            "description": "Krijon userin. Token-i i konfirmimit printohet NË KONSOLËN E SERVERIT (LoggingEmailSender).\nKopjoje dhe vendose te variabla `confirmToken`."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('envelope i plotë', () => {",
              "  const b = pm.response.json();",
              "  pm.expect(b).to.have.property('success', true);",
              "  pm.expect(b).to.have.property('statusCode');",
              "});",
              "console.log('➡️ Merr token-in e konfirmimit nga konsola e serverit dhe vendose te variabla confirmToken');"
            ]}
          }]
        },
        {
          "name": "Register — invalid (400)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"\",\n  \"lastName\": \"Tester\",\n  \"email\": \"nuk-eshte-email\",\n  \"password\": \"abc\",\n  \"confirmPassword\": \"ndryshe\"\n}" },
            "description": "ValidationFilter duhet ta ndalojë PARA controller-it. Prit disa gabime njëherësh."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('400', () => pm.response.to.have.status(400));",
              "pm.test('ka errors për disa fusha', () => {",
              "  const b = pm.response.json();",
              "  pm.expect(b.success).to.eql(false);",
              "  pm.expect(Object.keys(b.errors).length).to.be.above(1);",
              "});"
            ]}
          }]
        },
        {
          "name": "Register — email i zënë (409)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Tester\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"confirmPassword\": \"{{testPassword}}\"\n}" },
            "description": "Ekzekutoje PAS Register-it të parë. Dëshmon ErrorOr → 409."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
              "pm.test('success = false', () => pm.expect(pm.response.json().success).to.eql(false));"
            ]}
          }]
        },
        {
          "name": "Confirm Email",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/confirm-email", "host": ["{{baseUrl}}"], "path": ["api", "auth", "confirm-email"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"token\": \"{{confirmToken}}\"\n}" },
            "description": "⚠️ Vendos `confirmToken` nga konsola e serverit i pari."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] }
          }]
        },
        {
          "name": "Resend Confirmation",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/resend-confirmation", "host": ["{{baseUrl}}"], "path": ["api", "auth", "resend-confirmation"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\"\n}" },
            "description": "Token i ri në konsolë. Provoje edhe me email që NUK ekziston — duhet i njëjti 200."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] }
          }]
        },
        {
          "name": "Login — user testues (200)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}" },
            "description": "Token-i ruhet automatikisht te variabla `token`."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "if (b.data && b.data.token) {",
              "  pm.collectionVariables.set('token', b.data.token);",
              "  pm.collectionVariables.set('userId', b.data.userId);",
              "  console.log('✅ token u ruajt');",
              "}"
            ]}
          }]
        },
        {
          "name": "Login — ADMIN (200)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
            "description": "⚠️ Ekzekutoje KËTË para çdo kërkese te folderi 03 · Users — ato kërkojnë rolin Admin."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "if (b.data && b.data.token) {",
              "  pm.collectionVariables.set('token', b.data.token);",
              "  console.log('✅ token i ADMINIT u ruajt');",
              "}",
              "pm.test('ka rolin Admin', () => pm.expect(b.data.roles).to.include('Admin'));"
            ]}
          }]
        },
        {
          "name": "Login — password gabim (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Gabim@9999\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('401', () => pm.response.to.have.status(401));"] }
          }]
        },
        {
          "name": "Login — email që s'ekziston (401 — i njëjti!)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"nuk-ekziston@fake.com\",\n  \"password\": \"Gabim@9999\"\n}" },
            "description": "🔒 TEST SIGURIE: duhet TË NJËJTIN gabim si password i gabuar.\nNëse ndryshon, dikush mund të zbulojë cilët email-a janë të regjistruar."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('401 — jo 404', () => pm.response.to.have.status(401));",
              "pm.test('mesazh identik me password gabim', () => {",
              "  pm.expect(pm.response.json().message.toLowerCase()).to.include('incorrect');",
              "});"
            ]}
          }]
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "forgot-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\"\n}" },
            "description": "Token-i i reset-it printohet në KONSOLË → vendose te `resetToken`."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "console.log('➡️ Merr resetToken nga konsola');"
            ]}
          }]
        },
        {
          "name": "Forgot Password — email fals (200 — i njëjti!)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "forgot-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"nuk-ekziston@fake.com\"\n}" },
            "description": "🔒 TEST SIGURIE: përgjigje identike me atë të mësipërme."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('200 — pa zbuluar asgjë', () => pm.response.to.have.status(200));"] }
          }]
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "reset-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"IRi@Password9\",\n  \"confirmNewPassword\": \"IRi@Password9\"\n}" },
            "description": "Pas kësaj: login me password-in e vjetër → 401, me të riun → 200.\nDhe ripërdorimi i të njëjtit token → 400 (SecurityStamp ndryshoi)."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] }
          }]
        },
        {
          "name": "Logout — pa token (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('401', () => pm.response.to.have.status(401));"] }
          }]
        },
        {
          "name": "Logout — me token (200)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] },
            "description": "⚠️ Serveri NUK e revokon token-in — JWT është stateless. Klienti duhet ta fshijë vetë."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] }
          }]
        }
      ]
    },
    {
      "name": "02 · Account",
      "item": [
        {
          "name": "Me — pa token (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/account/me", "host": ["{{baseUrl}}"], "path": ["api", "account", "me"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('401', () => pm.response.to.have.status(401));"] }
          }]
        },
        {
          "name": "Me — me token (200)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/account/me", "host": ["{{baseUrl}}"], "path": ["api", "account", "me"] },
            "description": "Lexohet vetëm nga claims-et e token-it — ZERO query në databazë."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('data ka userId, email, roles', () => {",
              "  const d = pm.response.json().data;",
              "  pm.expect(d).to.have.property('userId');",
              "  pm.expect(d).to.have.property('email');",
              "  pm.expect(d).to.have.property('roles');",
              "});"
            ]}
          }]
        },
        {
          "name": "Me — token i FALSIFIKUAR (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}X" }],
            "url": { "raw": "{{baseUrl}}/api/account/me", "host": ["{{baseUrl}}"], "path": ["api", "account", "me"] },
            "description": "🔒 TESTI MË I RËNDËSISHËM: një shkronjë e shtuar prish nënshkrimin.\nDëshmon që ValidateIssuerSigningKey punon."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('401 — nënshkrimi u verifikua', () => pm.response.to.have.status(401));"] }
          }]
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/account/change-password", "host": ["{{baseUrl}}"], "path": ["api", "account", "change-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"{{testPassword}}\",\n  \"newPassword\": \"Ndryshuar@2026\",\n  \"confirmNewPassword\": \"Ndryshuar@2026\"\n}" },
            "description": "⚠️ ID-ja e userit merret nga TOKEN-i, kurrë nga trupi — mbrojtje nga IDOR.\nPërshtat emrat e fushave sipas ChangePasswordRequest tënd."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] }
          }]
        }
      ]
    },
    {
      "name": "03 · Users (vetëm Admin)",
      "item": [
        {
          "name": "Get Users — si ADMIN (200)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] },
            "description": "⚠️ Ekzekuto 'Login — ADMIN' i pari."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const d = pm.response.json().data;",
              "if (Array.isArray(d) && d.length > 0) {",
              "  const target = d.find(u => u.email === pm.collectionVariables.get('testEmail'));",
              "  if (target) { pm.collectionVariables.set('userId', target.id); console.log('✅ userId u ruajt'); }",
              "}",
              "pm.test('nuk ka PasswordHash', () => {",
              "  pm.expect(JSON.stringify(d)).to.not.include('passwordHash');",
              "});"
            ]}
          }]
        },
        {
          "name": "Get Users — si EMPLOYEE (403)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] },
            "description": "⚠️ Ekzekuto 'Login — user testues' i pari.\n🔒 403 = të njohim, po s'të lejohet. NUK duhet 401."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('403 Forbidden — jo 401', () => pm.response.to.have.status(403));"] }
          }]
        },
        {
          "name": "Assign Role — IT-Manager",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}/roles", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}", "roles"] },
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"IT-Manager\"\n}" },
            "description": "Kjo është arsyeja pse UsersController ekziston — pa të s'ke IT-Manager për të testuar asetet."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] }
          }]
        },
        {
          "name": "Assign Role — rol që s'ekziston (404)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}/roles", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}", "roles"] },
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"SuperAdmin\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('404 ose 400', () => pm.expect([400, 404]).to.include(pm.response.code));"] }
          }]
        },
        {
          "name": "Remove Role — IT-Manager",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}/roles/IT-Manager", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}", "roles", "IT-Manager"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] }
          }]
        }
      ]
    }
  ]
}
